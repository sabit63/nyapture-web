# Host address and port exposed by Docker Compose.
# Use 127.0.0.1 for local-only access or 0.0.0.0 for all interfaces.
NYA_WEB_BIND=127.0.0.1
NYA_WEB_PORT=8080

# Optional API address that Nginx can reach from inside the web container.
# The default is http://host.docker.internal:5270.
# NYA_API_TARGET=http://api:5270

# Optional browser-visible API URL baked into the frontend image.
# Leave empty to use the web app origin and the Nginx reverse proxy above.
VITE_NYA_API_URL=

# Optional browser-visible API keys baked into the frontend image.
# Anyone who can load the web app can inspect these values.
NYA_API_KEY=
NYA_EDIT_KEY=
