# Host port exposed by Docker Compose.
NYA_WEB_PORT=8080

# API address that Nginx can reach from inside the web container.
NYA_API_TARGET=http://host.docker.internal:5270

# Optional browser-visible API URL baked into the frontend image.
# Leave empty to use the web app origin and the Nginx reverse proxy above.
VITE_NYA_API_URL=
